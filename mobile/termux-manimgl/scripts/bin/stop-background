#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail
WORK="${MANIMGL_WORKSPACE:-$HOME/manimgl-workspace}"
SESSIONFILE="$WORK/background/latest.session"
SESSION="${MANIMGL_BACKGROUND_SESSION:-manimgl-bg}"
[ -f "$SESSIONFILE" ] && SESSION="$(cat "$SESSIONFILE")"
if command -v tmux >/dev/null 2>&1 && tmux has-session -t "$SESSION" 2>/dev/null; then
    tmux kill-session -t "$SESSION" 2>/dev/null || true
    echo "Stopped background tmux session: $SESSION"
else
    echo "Background tmux session was not running: $SESSION"
fi
if command -v termux-wake-unlock >/dev/null 2>&1; then
    termux-wake-unlock >/dev/null 2>&1 || true
fi
