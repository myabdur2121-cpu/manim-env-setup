#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

RUN_RENDER=0
if [ "${1:-}" = "--render" ]; then
    RUN_RENDER=1
fi

echo "=== ManimGL mobile CPU/llvmpipe test ==="

echo
echo "[1/3] CPU context check"
check-manimgl-cpu

echo
echo "[2/3] Python import check"
python - <<'PY'
mods = ['manimlib', 'moderngl', 'glcontext', 'numpy', 'scipy', 'PIL', 'matplotlib', 'manimpango']
for name in mods:
    mod = __import__(name)
    print('OK', name, getattr(mod, '__version__', ''))
PY

echo
echo "[3/3] Workspace check"
WORK="${MANIMGL_WORKSPACE:-$HOME/manimgl-workspace}"
if [ -f "$WORK/test_scene.py" ]; then
    echo "OK test scene: $WORK/test_scene.py"
else
    echo "Missing test scene: $WORK/test_scene.py"
    exit 1
fi

if [ "$RUN_RENDER" -eq 1 ]; then
    echo
    echo "Running quick 480p CPU render test..."
    cd "$WORK"
    rendercpu test_scene.py MobileRenderTest -l
else
    echo
    echo "CPU smoke test done. To include actual CPU render test:"
    echo "  test-manimgl-cpu --render"
fi
